# CrabBots Attendance - environment template
# Copy to .env and adjust. All values are optional; sensible defaults apply.

# Where the SQLite database lives (relative paths resolve from repo root)
CRABBOTS_DB_PATH=data/crabbots.db

# Directory for downloaded ONNX models
CRABBOTS_MODEL_DIR=backend/models

# Set a token to protect mutating settings endpoints (recommended outside a local demo).
# When empty, settings are writable by anyone who can reach the UI (documented tradeoff).
CRABBOTS_ADMIN_TOKEN=

# Bind address for `python -m backend.run`
CRABBOTS_HOST=127.0.0.1
CRABBOTS_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
CRABBOTS_LOG_LEVEL=INFO
